{
  "expo": {
    "name": "VbeatS",
    "slug": "vbeats-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vbeats",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vbeats.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VbeatS needs microphone access so creators can record beat previews and performances.",
        "NSCameraUsageDescription": "VbeatS uses camera access for profile and beat artwork uploads.",
        "NSPhotoLibraryUsageDescription": "VbeatS uses photo library access for profile and beat artwork uploads."
      }
    },
    "android": {
      "package": "com.vbeats.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow VbeatS to access your microphone for recording performances."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "13.4"
          },
          "android": {
            "minSdkVersion": 21,
            "compileSdkVersion": 33,
            "targetSdkVersion": 33
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.vbeats.app",
      "blockchainRpc": "https://mainnet.base.org"
    }
  }
}
