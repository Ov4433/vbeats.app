// VBeats backend data model.
// Canonical storage uses one field name; the API serializes BOTH the demo
// names (desc, dur, date) and the mobile-app names (description, duration,
// createdAt) so both clients work unchanged.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  username     String         @unique
  passwordHash String
  wallet       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  beats        Beat[]
  refreshTokens RefreshToken[]
  purchases    Transaction[]  @relation("Buyer")
  sales        Transaction[]  @relation("Seller")
  plays        Play[]
  chatMessages ChatMessage[]
  votes        Vote[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  body      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Beat {
  id          String   @id @default(cuid())
  title       String
  genre       String
  bpm         Int?
  musicalKey  String?
  price       Float
  description String?
  durationSec Int      @default(0)
  audioUrl    String?
  imageUrl    String?
  fingerprint String?  @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHouse     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
  plays       Play[]
  votes       Vote[]

  @@index([userId])
  @@index([genre])
}

model Transaction {
  id              String   @id @default(cuid())
  beatId          String
  beat            Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation("Buyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User     @relation("Seller", fields: [sellerId], references: [id])
  amount          Float
  currency        String   @default("usd")
  type            String   @default("license") // license | purchase
  status          String   @default("completed")
  stripePaymentId String?
  createdAt       DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@index([beatId])
}

model Play {
  id          String   @id @default(cuid())
  beatId      String
  beat        Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  userId      String? // null = anonymous listener
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash      String? // sha256(ip + daily salt) for anonymous dedupe; never a raw IP
  listenedSec Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([beatId])
  @@index([userId])
  @@index([createdAt])
}

model Vote {
  id            String   @id @default(cuid())
  beatId        String
  beat          Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String?
  weight        Int
  createdAt     DateTime @default(now())

  @@unique([beatId, userId])
  @@index([beatId])
  @@index([createdAt])
}

// A Volt Pass claim (token-gated buy-in). One per wallet; memberNumber is
// the pass tokenId on Base — the member counter and the showcase gate
// (unlocks at SHOWCASE_MEMBER_GOAL members) read from here / on-chain.
model PassClaim {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  bat           String
  memberNumber  Int      @unique
  txHash        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
