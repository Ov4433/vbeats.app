# Copy to .env and fill in. Never commit real secrets.
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL connection string
DATABASE_URL="postgresql://vbeats:vbeats@localhost:5432/vbeats?schema=public"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS: comma-separated allowed origins (the Expo/web client)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Durable audio storage — Cloudflare R2 (S3-compatible). Set all five to
# store uploads in R2 (beats keep the public URL). Leave blank for the
# local-disk fallback (files do not survive a redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Brand assets directory (defaults to ../brand relative to backend/)
BRAND_DIR=

# Stripe (stub webhook only for now)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# On-chain beat verification (read-only). Leave blank to disable.
RPC_URL=
BEAT_REGISTRY_ADDRESS=
BEAT_NFT_ADDRESS=
# Relayer wallet private key (0x…) for register-on-upload. Optional: when set,
# every beat upload fires a BeatRegistry.registerBeat tx on Base (gas paid by
# this wallet — keep a small ETH balance on it). Leave empty to disable.
# Never commit a real key; set it in the Render dashboard env instead.
RELAYER_KEY=
