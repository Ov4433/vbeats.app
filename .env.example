# Public runtime config (Expo)
EXPO_PUBLIC_API_URL=https://api.vbeats.app
# Local dev against `docker compose up`: use your machine's LAN IP
# (a physical phone can't reach localhost).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_BLOCKCHAIN_RPC=https://mainnet.base.org

# EAS project linkage
EAS_PROJECT_ID=

# Backend API secrets (server-side only; never expose in client builds)
STRIPE_SECRET_KEY=
BLOCKCHAIN_RPC_URL=https://mainnet.base.org

# Smart contract addresses
PRODUCER_STAKING_CONTRACT=
ROYALTY_SPLITTER_CONTRACT=
PLATFORM_TOKEN_ADDRESS=

# Environment
NODE_ENV=production
PORT=7000
