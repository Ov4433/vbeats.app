## 🖥️ 2. BACKEND API SERVER (Node.js / Express)

### A. Core Gateway Server (`server.js`)
```javascript
const express = require('express');
const cors = require('cors');
const Stripe = require('stripe');
const { ethers } = require('ethers');
require('dotenv').config();

const app = express();
app.use(cors());
app.use(express.json());

const stripe = Stripe(process.env.STRIPE_SECRET_KEY);
const provider = new ethers.JsonRpcProvider(process.env.BLOCKCHAIN_RPC_URL);

const MINIMAL_ERC20_ABI = ["function balanceOf(address owner) view returns (uint256)"];

let producersProfileDatabase = {
  "0xProducerMetroAddress11111111111111111111": { name: "Producer Metro", producerCoinContract: "0xYourTokenAddress", requiredPT: 50, requiredAC: 500 }
};

app.post('/api/messages/send', async (req, res) => {
  const { rapperWallet, artistCoinContract, producerWallet, messageText } = req.body;
  const profile = producersProfileDatabase[producerWallet];
  if (!profile) return res.status(404).json({ error: "Producer not found." });

  try {
    const ptContract = new ethers.Contract(profile.producerCoinContract, MINIMAL_ERC20_ABI, provider);
    const acContract = new ethers.Contract(artistCoinContract, MINIMAL_ERC20_ABI, provider);

    const ptBalance = Number(ethers.formatUnits(await ptContract.balanceOf(rapperWallet), 18));
    const acBalance = Number(ethers.formatUnits(await acContract.balanceOf(rapperWallet), 18));

    if (ptBalance < profile.requiredPT && acBalance < profile.requiredAC) {
      return res.status(403).json({ error: "INBOX LOCKED: Anti-Spam Gate Active." });
    }

    res.status(201).json({ success: true, msg: "Message passed anti-spam gate!" });
  } catch (err) {
    res.status(500).json({ error: "Verification failed." });
  }
});

app.listen(7000, () => console.log('🚀 API server active on port 7000'));
