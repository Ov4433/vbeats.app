## 📱 3. MOBILE STUDIO CLIENT (React Native / Expo)

### A. Gated Studio Interface (`StudioScreen.js`)
```javascript
import React, { useState, useEffect } from 'react';
import { StyleSheet, Text, View, TouchableOpacity, Alert } from 'react-native';
import { Audio } from 'expo-av';
import { useWallet, useContract, useContractRead } from '@thirdweb-dev/react-native';

export default function StudioScreen() {
  const walletAddress = useWallet()?.address;
  const { contract } = useContract("0xYourTokenAddress");
  const { data: balance } = useContractRead(contract, "balanceOf", [walletAddress]);
  
  const [hasAccess, setHasAccess] = useState(false);
  const [recording, setRecording] = useState(null);
  const [beatSound, setBeatSound] = useState(null);

  useEffect(() => {
    if (balance) {
      setHasAccess((Number(balance) / 10**18) >= 10);
    }
  }, [balance]);

  async function startRecording() {
    try {
      await Audio.requestPermissionsAsync();
      await Audio.setAudioModeAsync({ allowsRecordingIOS: true, playsInSilentModeIOS: true });

      const { sound } = await Audio.Sound.createAsync({ uri: 'https://vbeats.com' });
      setBeatSound(sound);

      const recorder = new Audio.Recording();
      await recorder.prepareToRecordAsync(Audio.RecordingOptionsPresets.HIGH_QUALITY);
      
      await sound.playAsync();
      await recorder.startAsync();
      setRecording(recorder);
    } catch (err) {
      Alert.alert("Hardware Error", err.message);
    }
  }

  async function stopRecording() {
    setRecording(null);
    await beatSound.stopAsync();
    await recording.stopAndUnloadAsync();
    Alert.alert("Saved", "Track mixed securely to local storage cache.");
  }

  return (
    <View style={styles.container}>
      {hasAccess ? (
        <TouchableOpacity style={styles.recordBtn} onPress={recording ? stopRecording : startRecording}>
          <Text style={styles.text}>{recording ? "🛑 STOP PERFORMANCE" : "🎤 RECORD OVER BEAT"}</Text>
        </TouchableOpacity>
      ) : (
        <Text style={styles.locked}>🔒 Studio Locked: Hold 10 $VPT to pass watermark gates.</Text>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#09090C', justifyContent: 'center', alignItems: 'center' },
  recordBtn: { backgroundColor: '#FF0055', padding: 20, borderRadius: 30 },
  text: { color: '#FFF', fontWeight: 'bold' },
  locked: { color: '#FF3366', fontWeight: '700', padding: 20, textAlign: 'center' }
});
```
