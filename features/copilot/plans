## ⛓️ 1. SMART CONTRACTS (Solidity)

### A. Multi-Party Royalty Splitter (`RoyaltySplitter.sol`)
```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/security/ReentrancyGuard.sol";

contract RoyaltySplitter is ReentrancyGuard {
    address public producer;
    address public artist;
    uint256 public producerSplit; // Basis points (e.g. 5000 = 50%)
    uint256 public artistSplit;

    event PaymentReceived(address indexed from, uint256 amount);
    event RoyaltyWithdrawn(address indexed to, uint256 amount);

    constructor(address _producer, address _artist, uint256 _producerSplit) {
        require(_producerSplit <= 10000, "Split cannot exceed 100%");
        producer = _producer;
        artist = _artist;
        producerSplit = _producerSplit;
        artistSplit = 10000 - _producerSplit;
    }

    receive() external payable {
        emit PaymentReceived(msg.sender, msg.value);
    }

    function distributeRoyalties() external nonReentrant {
        uint256 totalBalance = address(this).balance;
        require(totalBalance > 0, "No royalties available");

        uint256 producerShare = (totalBalance * producerSplit) / 10000;
        uint256 artistShare = totalBalance - producerShare;

        if (producerShare > 0) payable(producer).transfer(producerShare);
        if (artistShare > 0) payable(artist).transfer(artistShare);
    }
}
```

### B. Anti-Piracy Slashing Escrow (`ProducerStaking.sol`)
```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract ProducerStaking is ReentrancyGuard, Ownable {
    IERC20 public platformToken;
    uint256 public minimumStakeAmount = 500 * 10**18;
    uint256 public lockDuration = 30 days;

    struct StakeProfile {
        uint256 amount;
        uint256 releaseTime;
        bool isRegisteredProducer;
    }

    mapping(address => StakeProfile) public producerStakes;

    event Staked(address indexed producer, uint256 amount, uint256 releaseTime);
    event Unstaked(address indexed producer, uint256 amount);
    event ProducerSlashed(address indexed violator, uint256 amountSlashed, string reason);

    constructor(address _platformToken) Ownable(msg.sender) {
        platformToken = IERC20(_platformToken);
    }

    function stakeForStudioAccess(uint256 _amount) external nonReentrant {
        require(_amount >= minimumStakeAmount, "Below minimum threshold");
        require(platformToken.transferFrom(msg.sender, address(this), _amount), "Transfer failed");

        producerStakes[msg.sender].amount += _amount;
        producerStakes[msg.sender].releaseTime = block.timestamp + lockDuration;
        producerStakes[msg.sender].isRegisteredProducer = true;

        emit Staked(msg.sender, _amount, producerStakes[msg.sender].releaseTime);
    }

    function withdrawStudioStake() external nonReentrant {
        StakeProfile storage profile = producerStakes[msg.sender];
        require(profile.amount > 0, "No active stake");
        require(block.timestamp >= profile.releaseTime, "Assets locked");

        uint256 amountToReturn = profile.amount;
        profile.amount = 0;
        profile.isRegisteredProducer = false;

        require(platformToken.transfer(msg.sender, amountToReturn), "Transfer failed");
        emit Unstaked(msg.sender, amountToReturn);
    }

    function slashViolator(address _violator, string memory _reason) external onlyOwner {
        StakeProfile storage profile = producerStakes[_violator];
        require(profile.amount > 0, "No assets to slash");

        uint256 slashedAmount = profile.amount;
        profile.amount = 0;
        profile.isRegisteredProducer = false;

        require(platformToken.transfer(owner(), slashedAmount), "Slashing failed");
        emit ProducerSlashed(_violator, slashedAmount, _reason);
    }
}
